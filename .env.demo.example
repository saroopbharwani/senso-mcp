# Copy to .env.demo. Never commit your populated file.
ASTRA_MODEL=gpt-6-astra
ASTRA_PORT=8800
CTA_BASE=http://localhost:8899

# Standard OpenAI API (leave the Azure fields blank):
OPENAI_API_KEY=

# Or Azure OpenAI Responses API; use your own resource and deployment:
AZURE_OPENAI_RESPONSES_URL=
AZURE_OPENAI_API_KEY=
# Set ASTRA_MODEL above to your Azure deployment name.
